# hafleet settings. Restart after changes: rc-service hafleet restart
# All options: hafleet serve -h

HAFLEET_LISTEN=:8080
HAFLEET_DATA_DIR=/var/lib/hafleet
HAFLEET_SECRET_KEY_FILE=/etc/hafleet/secret.key

# Out of the box hafleet serves plain HTTP, where browsers drop Secure cookies.
# For HTTPS, either put hafleet behind a reverse proxy and set this to true,
# or set HAFLEET_TLS_CERT/HAFLEET_TLS_KEY (cookies are then Secure automatically).
HAFLEET_SECURE_COOKIES=false
#HAFLEET_TLS_CERT=/etc/hafleet/cert.pem
#HAFLEET_TLS_KEY=/etc/hafleet/key.pem
#HAFLEET_ALLOWED_ORIGINS=https://hafleet.example.com

# Prometheus /metrics, scraped with "Authorization: Bearer <token>" (min. 16 characters).
#HAFLEET_METRICS_TOKEN=

# Optional AI features (see README).
#HAFLEET_AI_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#HAFLEET_AI_PROVIDER=ollama
#HAFLEET_OLLAMA_URL=http://ollama.lan:11434
#HAFLEET_OLLAMA_MODEL=
